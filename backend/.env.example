FRONTEND_URL=http://localhost:5173
DEVELOPMENT_MODE=true
DATA_DIR=var
DATABASE_URL=sqlite:///var/library.db
MAX_UPLOAD_BYTES=20971520
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_FALLBACK_MODELS_OPENCODE=kimi-k2.6
AI_FALLBACK_MODELS_OPENROUTER=openai/gpt-4o-mini
AI_CONTEXT_BUDGET=8000
AI_SECRET_KEY=change-me-to-a-random-secret
# Provider keys (fallback when no key is saved via the AI Settings UI;
# a UI-saved key always wins). OPENROUTER_API_KEY is an alias.
# OPENCODE_API_KEY=key_here
OPEN_ROUTER_KEY=key_here
CARTESIA_API_KEY=key_here
# Base voice-clone reference (defaults: backend/my_voice.wav + backend/audio_ref_script.txt)
# TTS_REF_AUDIO=/absolute/path/to/my_voice.wav
# TTS_REF_TEXT_FILE=/absolute/path/to/audio_ref_script.txt
# TTS_REF_TEXT=exact transcript string (overrides TTS_REF_TEXT_FILE)
