wipe(c32, at: 70.2, over: 0.01, visual: none)
reveal(c00, at: 70.6, over: 0.5, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: writeSfx)
reveal(c01, at: 71.5, over: 0.6, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: writeSfx)
