reveal(c10, at: 73.5, over: 0.3, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: writeSfx)
