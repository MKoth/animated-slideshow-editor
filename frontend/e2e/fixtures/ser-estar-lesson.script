// Lesson 02 — Ser and Estar (assembled from 5 per-step blackboard prompts).
// Effects are the only appearance/disappearance transitions in this lesson.
// Run the creation portion first so Check has measured bounds, then the full
// source replaces it with the complete scene and choreography.
//
// HOW TO RUN (two passes; the second replaces the first, nothing duplicates):
//   1. Run everything above the "Each object starts hidden" marker to create
//      the scene. 2. Park the playhead where a table is fully written
//      (~120s, conjugation table) so Check measures real bounds, then Check
//      the full source (expect 0 errors), Save, Run. A repeat full Run
//      replaces its own clips/effects instead of duplicating them.
// NEEDS from the library: images "oak-tree", "melting-ice-cube", "red-fox",
// "brown-suitcase", paws "paw with chalk", "paw with rag", "paw with laser",
// "paw empty", audio "writing-on-black-board" and "dry-erase", material
// "Chalk". Browse each folder in Assets first so names resolve. Import the
// four picture images before Run (Check reports unknown assets until then).
//
// Windows are pre-TTS ESTIMATES (0.2s/char compressed to a 132s slide):
// part-0 Step 1: 0-12, part-1 Step 2: 12-36, part-2 Step 3: 36-60,
// part-3 Step 4: 60-92, part-4 Step 5: 92-132. TTS will adopt measured
// durations later; every effect stays inside its owning narration window
// so retiming stays proportional.
//
// PACING (same scheme as the Spanish-gender lesson):
// - One stage at a time; nothing overlaps; 2.5-3.5s pauses between stages.
// - Picture stages: card placed first, labels written below, labels wiped,
//   then card flown away. Never show-then-instantly-remove.
// - Cards sit at y 360 (0.34 scale); labels below at y 505/548.
// - Mask-setup wipes (visual: none, over: 0.01) hide cell contents while the
//   border draws; silent and straight by design.
// - mark and carry take no sound or wobble (the language forbids it there).
// WOBBLE: full for words {12-24}/{8-18} speed 7; little for two-glyph cells
// {4-8}/{3-6}; none for lone dashes; wide table borders triple-Y {24-54}.
// DURATIONS: ~0.1s per char, 0.3s floor; table cells chained with ~0.4-0.5s
// breath. SOUND: reveal -> writeSfx, wipe -> eraseSfx; carry/mark silent.
script "Ser and Estar" from 0
defaults { duration: 0.5s, ease: easeInOut }
let cw = 1090
bind chalk = material("Chalk")
create asset "paw with chalk" as chalkpaw at (1500, 1200) { scaleX: 0.12, scaleY: 0.12 }
create asset "paw with rag" as ragpaw at (1640, 1200) { scaleX: 0.12, scaleY: 0.12 }
create asset "paw with laser" as laserpaw at (1780, 1200) { scaleX: 0.12, scaleY: 0.12 }
create asset "paw empty" as pawempty at (1920, 1200) { scaleX: 0.12, scaleY: 0.12 }
create group "Ser Estar board" as board
board.material(chalk)
create text "Ser Estar title" as s1title at (cw / 2, 220) inside board { content: "Ser and Estar", fontSize: 64, alignment: "center" }
s1title.tint("#F5E6C8")
// Each object starts hidden by its reveal mask and is erased by a wipe mask.
bind chalkHand = node("paw with chalk")
bind ragHand = node("paw with rag")
bind laserHand = node("paw with laser")
bind emptyHand = node("paw empty")
bind writeSfx = audio("writing-on-black-board")
bind eraseSfx = audio("dry-erase")
bind tS1 = node("Ser Estar title")
mark("part-0")
reveal(tS1, at: 1.0, over: 1.5, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: writeSfx)
wipe(tS1, at: 8.0, over: 1.0, visual: ragHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: eraseSfx)
create text "Ser identity title" as s2title at (545, 150) inside board { content: "Ser = lasting identity", fontSize: 40, alignment: "center" }
create asset "oak-tree" as oakTree at (1500, 1200) { scaleX: 0.34, scaleY: 0.34 }
create text "Oak label" as s2l1 at (545, 505) inside board { content: "Oak tree - lasting and solid", fontSize: 26, alignment: "center" }
create text "Oak label ES" as s2l2 at (545, 548) inside board { content: "Árbol de roble - duradero y sólido", fontSize: 26, alignment: "center" }
s2title.tint("#F5E6C8")
s2l1.tint("#F5E6C8")
s2l2.tint("#F5E6C8")
bind tS2 = node("Ser identity title")
bind imgOak = node("oak-tree")
bind tS2L1 = node("Oak label")
bind tS2L2 = node("Oak label ES")
mark("part-1")
reveal(tS2, at: 12, over: 1.5, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: writeSfx)
carry(imgOak, to: { x: 545, y: 360 }, approach: { x: 1500, y: 900 }, approachOver: 0.8, at: 16, over: 1.5, visual: emptyHand, visualScale: 4, visualAnchor: "top-center")
reveal(tS2L1, at: 20, over: 0.8, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: writeSfx)
reveal(tS2L2, at: 21.1, over: 0.8, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: writeSfx)
wipe(tS2L1, at: 24.4, over: 0.6, visual: ragHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: eraseSfx)
wipe(tS2L2, at: 25.3, over: 0.6, visual: ragHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: eraseSfx)
carry(imgOak, to: { x: 1500, y: 1200 }, approach: { x: 545, y: 360 }, approachOver: 0.8, at: 28.4, over: 1.5, visual: emptyHand, visualScale: 4, visualAnchor: "top-center")
wipe(tS2, at: 32.4, over: 1.0, visual: ragHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: eraseSfx)
create text "Estar state title" as s3title at (545, 150) inside board { content: "Estar = temporary state and place", fontSize: 40, alignment: "center" }
create asset "melting-ice-cube" as iceCube at (1500, 1200) { scaleX: 0.34, scaleY: 0.34 }
create text "Ice label" as s3l1 at (545, 505) inside board { content: "Melting ice cube - cold right now", fontSize: 26, alignment: "center" }
create text "Ice label ES" as s3l2 at (545, 548) inside board { content: "Cubito de hielo - frío ahora mismo", fontSize: 26, alignment: "center" }
s3title.tint("#F5E6C8")
s3l1.tint("#F5E6C8")
s3l2.tint("#F5E6C8")
bind tS3 = node("Estar state title")
bind imgIce = node("melting-ice-cube")
bind tS3L1 = node("Ice label")
bind tS3L2 = node("Ice label ES")
mark("part-2")
reveal(tS3, at: 36, over: 1.5, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: writeSfx)
carry(imgIce, to: { x: 545, y: 360 }, approach: { x: 1500, y: 900 }, approachOver: 0.8, at: 39.5, over: 1.5, visual: emptyHand, visualScale: 4, visualAnchor: "top-center")
reveal(tS3L1, at: 43, over: 0.8, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: writeSfx)
reveal(tS3L2, at: 45.8, over: 0.8, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: writeSfx)
wipe(tS3L1, at: 48.6, over: 0.6, visual: ragHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: eraseSfx)
wipe(tS3L2, at: 51.2, over: 0.6, visual: ragHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: eraseSfx)
carry(imgIce, to: { x: 1500, y: 1200 }, approach: { x: 545, y: 360 }, approachOver: 0.8, at: 53.8, over: 1.5, visual: emptyHand, visualScale: 4, visualAnchor: "top-center")
wipe(tS3, at: 57.3, over: 1.0, visual: ragHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: eraseSfx)
create text "Step4 title" as s4title at (545, 120) inside board { content: "Same word, different verb, different meaning", fontSize: 32, alignment: "center" }
create asset "red-fox" as fox at (1500, 1200) { scaleX: 0.34, scaleY: 0.34 }
create text "Fox label" as s4foxl at (340, 505) inside board { content: "Red fox - es listo means clever", fontSize: 22, alignment: "center" }
create asset "brown-suitcase" as suitcase at (1640, 1200) { scaleX: 0.34, scaleY: 0.34 }
create text "Case label" as s4casel at (750, 505) inside board { content: "Brown suitcase - está listo means ready", fontSize: 22, alignment: "center" }
create table "Step 4 table" as t4grid at (290, 580) inside board { columns: [170, 170, 170], rows: [["", "", ""], ["", "", ""], ["", "", ""], ["", "", ""]], padding: 6, borderWidth: 2, borderColor: "#FFFFFF", background: "transparent" }
create text "t4c00" as c00 at (5, 5) inside t4grid.cell(0, 0) { content: "Spanish", fontSize: 17 }
create text "t4c01" as c01 at (5, 5) inside t4grid.cell(0, 1) { content: "Meaning with ser", fontSize: 17 }
create text "t4c02" as c02 at (5, 5) inside t4grid.cell(0, 2) { content: "Meaning with estar", fontSize: 17 }
create text "t4c10" as c10 at (5, 5) inside t4grid.cell(1, 0) { content: "listo", fontSize: 17 }
create text "t4c11" as c11 at (5, 5) inside t4grid.cell(1, 1) { content: "clever", fontSize: 17 }
create text "t4c12" as c12 at (5, 5) inside t4grid.cell(1, 2) { content: "ready", fontSize: 17 }
create text "t4c20" as c20 at (5, 5) inside t4grid.cell(2, 0) { content: "aburrido", fontSize: 17 }
create text "t4c21" as c21 at (5, 5) inside t4grid.cell(2, 1) { content: "boring", fontSize: 17 }
create text "t4c22" as c22 at (5, 5) inside t4grid.cell(2, 2) { content: "bored", fontSize: 17 }
create text "t4c30" as c30 at (5, 5) inside t4grid.cell(3, 0) { content: "bueno", fontSize: 17 }
create text "t4c31" as c31 at (5, 5) inside t4grid.cell(3, 1) { content: "good person", fontSize: 17 }
create text "t4c32" as c32 at (5, 5) inside t4grid.cell(3, 2) { content: "tasty / well", fontSize: 17 }
s4title.tint("#F5E6C8")
s4foxl.tint("#F5E6C8")
s4casel.tint("#F5E6C8")
c00.tint("#F5E6C8")
c01.tint("#F5E6C8")
c02.tint("#F5E6C8")
c10.tint("#F5E6C8")
