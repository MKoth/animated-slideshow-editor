c32.tint("#F5E6C8")
bind tS4 = node("Step4 title")
bind imgFox = node("red-fox")
bind tFoxL = node("Fox label")
bind imgCase = node("brown-suitcase")
bind tCaseL = node("Case label")
bind gT4 = table("Step 4 table")
bind c00 = node("t4c00")
bind c01 = node("t4c01")
bind c02 = node("t4c02")
bind c10 = node("t4c10")
