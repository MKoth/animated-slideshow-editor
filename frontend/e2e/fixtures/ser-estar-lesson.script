mark("part-3")
reveal(tS4, at: 60, over: 2.0, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: writeSfx)
carry(imgFox, to: { x: 340, y: 330 }, approach: { x: 1500, y: 1200 }, approachOver: 0.8, at: 62.4, over: 1.5, visual: emptyHand, visualScale: 4, visualAnchor: "top-center")
reveal(tFoxL, at: 64.3, over: 1.0, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: writeSfx)
carry(imgCase, to: { x: 750, y: 330 }, approach: { x: 1640, y: 1200 }, approachOver: 0.8, at: 65.7, over: 1.5, visual: emptyHand, visualScale: 4, visualAnchor: "top-center")
reveal(tCaseL, at: 67.6, over: 1.0, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: writeSfx)
reveal(gT4, at: 69, over: 1.2, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleY: { from: 24, to: 54 }, wobbleSpeed: 7, sound: writeSfx)
wipe(c00, at: 70.2, over: 0.01, visual: none)
wipe(c01, at: 70.2, over: 0.01, visual: none)
wipe(c02, at: 70.2, over: 0.01, visual: none)
wipe(c10, at: 70.2, over: 0.01, visual: none)
