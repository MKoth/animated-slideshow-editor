// Spanish noun gender — a separate, self-contained example for script authors.
// Effects are the only appearance/disappearance transitions in this lesson.
// Run the creation portion first so Check has measured bounds, then the full
// source replaces it with the complete scene and choreography.
//
// HOW TO RUN (two passes; the second replaces the first, nothing duplicates):
//   1. Run everything above the "Each object starts hidden" marker to create
//      the scene. 2. Park the playhead where the table is fully written
//      (~72s) so Check measures real bounds, then Check the full source
//      (expect 0 errors), Save, Run. A repeat full Run replaces its own
//      clips/effects instead of duplicating them.
// NEEDS from the library: images "female", "male", paws "paw with chalk",
// "paw with rag", "paw with laser", "paw empty", audio "writing-on-black-board"
// and "dry-erase", material "Chalk". Browse each folder in Assets first so
// names resolve.
//
// PACING SCHEME (why the numbers look the way they do):
// - One stage at a time. A performer sprite only exists while its effect is
//   active, so when an action ends its paw is gone: pause 2.5-3.5s, then the
//   next stage. Nothing ever overlaps; the E2E pins every audible gap.
// - Slide is 86s; the last effect ends at 83s, leaving a 3s tail.
// - Order of the picture stages: BOTH cards are placed first and share the
//   board, then a label is written below each, then labels are wiped, and
//   only then are the cards flown away. Never show-then-instantly-remove.
// - Cards sit low (y 365) with labels below them (y 500): the photos are
//   ~203 tall at 0.34 scale (bottoms ~466), the 26px labels start ~482, so
//   text never slides under the higher-z image. Anything stacked vertically
//   must be estimated from real asset sizes, not eyeballed.
// - Mask-setup wipes (visual: none, over: 0.01) hide cell contents while the
//   border draws; they are silent and perfectly straight by design.
// - mark and carry take no sound or wobble (the language forbids it there).
//
// WOBBLE SCHEME (why each sweep wiggles the way it does):
// - The revealed edge always moves straight; wobble only offsets the paw.
//   X-only wobble surges along the travel path (nearly invisible), so every
//   visible sweep also carries Y wobble — that perpendicular weave is what
//   reads as handwriting.
// - Full wobble for words: wobbleX { from: 12, to: 24 },
//   wobbleY { from: 8, to: 18 }, wobbleSpeed: 7.
// - Little wobble for two-glyph cells ("-a"/"-o"): { from: 4, to: 8 } /
//   { from: 3, to: 6 }. A lone dash ("—") gets none: a straight 0.3s
//   uncovering. Big wobble on tiny ink looks robotic, not handmade.
// - The wide table border gets triple Y wobble ({ from: 24, to: 54 }) so the
//   weave reads across its full width; X and speed stay at the usual values.
// - wobbleSpeed is wiggles/second; segments derive from speed × duration, so
//   short cells still get several weaves. Keep speed identical everywhere
//   unless a stage should feel calmer or busier.
//
// DURATION SCHEME (why writing time differs per cell):
// - Writing time grows with content: about 0.1s per character, 0.3s floor.
//   A dash takes 0.3s, "-a" 0.3s, "Género" 0.6s, "Terminación" 1.1s. Writing
//   one symbol at word speed (or a word at dash speed) reads as unnatural,
//   so chain cells with a 0.5s breath after each one ends: next start =
//   previous end + 0.5.
// - Effect SFX clips are planned from these durations (timelineStart equals
//   the effect start, source plays from 0), so retiming an effect retimes
//   its sound: 22 writing + 5 erasing clips, 27 total.
//
// SOUND SCHEME: reveal always carries sound: writeSfx, wipe always carries
// sound: eraseSfx. If a sweep goes silent, its sound: line was deleted —
// re-adding it and running restores the clip.
script "Spanish noun gender" from 0
defaults { duration: 0.5s, ease: easeInOut }

let cw = 1090
bind chalk = material("Chalk")

// The project already contains its blackboar-background scene node. Keep that
// one instance as the backdrop; this script only adds the lesson content.
create asset "paw with chalk" as chalkpaw at (1500, 1200) { scaleX: 0.12, scaleY: 0.12 }
create asset "paw with rag" as ragpaw at (1640, 1200) { scaleX: 0.12, scaleY: 0.12 }
create asset "paw with laser" as laserpaw at (1780, 1200) { scaleX: 0.12, scaleY: 0.12 }
create asset "paw empty" as emptypaw at (1920, 1200) { scaleX: 0.12, scaleY: 0.12 }

create group "Spanish lesson board" as board
board.material(chalk)

create text "Gender title" as title at (cw / 2 + 115, 135) inside board { content: "Género de los sustantivos", fontSize: 54, alignment: "center" }
title.tint("#F5E6C8")

create text "Gender explanation" as explanation at (cw / 2 + 115, 220) inside board { content: "Los sustantivos en español suelen ser masculinos o femeninos.", fontSize: 25, alignment: "center" }
explanation.tint("#F5E6C8")

// The picture cards travel in from either side, then their labels appear.
// Cards sit low (y 365) with labels below them (y 500): the photos are ~203
// tall at this scale, so their bottoms (~466) clear the labels' tops (~482).
create asset "female" as female at (1500, 1200) { scaleX: 0.34, scaleY: 0.34 }
create asset "male" as male at (1640, 1200) { scaleX: 0.34, scaleY: 0.34 }
create text "Feminine label" as feminineLabel at (340, 500) inside board { content: "FEMENINO", fontSize: 26, alignment: "center" }
create text "Masculine label" as masculineLabel at (750, 500) inside board { content: "MASCULINO", fontSize: 26, alignment: "center" }
feminineLabel.tint("#FFB7C5")
masculineLabel.tint("#81D4FA")

// Empty transparent table first; headers and each example are written later.
create table "Gender examples table" as grid at (180, 425) inside board { columns: [125, 125, 125, 155, 200], rows: [["", "", "", "", ""], ["", "", "", "", ""], ["", "", "", "", ""]], padding: 6, borderWidth: 2, borderColor: "#FFFFFF", background: "transparent" }

create text "Table header gender" as c00 at (5, 5) inside grid.cell(0, 0) { content: "Género", fontSize: 17 }
create text "Table header feminine" as c01 at (5, 5) inside grid.cell(0, 1) { content: "Femenino", fontSize: 17 }
create text "Table header masculine" as c02 at (5, 5) inside grid.cell(0, 2) { content: "Masculino", fontSize: 17 }
create text "Table header ending" as c03 at (5, 5) inside grid.cell(0, 3) { content: "Terminación", fontSize: 17 }
create text "Table header example" as c04 at (5, 5) inside grid.cell(0, 4) { content: "Ejemplo", fontSize: 17 }

create text "Feminine row gender" as c10 at (5, 5) inside grid.cell(1, 0) { content: "Femenino", fontSize: 17 }
create text "Feminine row feminine" as c11 at (5, 5) inside grid.cell(1, 1) { content: "-a", fontSize: 19 }
create text "Feminine row masculine" as c12 at (5, 5) inside grid.cell(1, 2) { content: "—", fontSize: 19 }
create text "Feminine row ending" as c13 at (5, 5) inside grid.cell(1, 3) { content: "-a", fontSize: 19 }
create text "Feminine row example" as c14 at (5, 5) inside grid.cell(1, 4) { content: "la mesa", fontSize: 19 }

create text "Masculine row gender" as c20 at (5, 5) inside grid.cell(2, 0) { content: "Masculino", fontSize: 17 }
create text "Masculine row feminine" as c21 at (5, 5) inside grid.cell(2, 1) { content: "—", fontSize: 19 }
create text "Masculine row masculine" as c22 at (5, 5) inside grid.cell(2, 2) { content: "-o", fontSize: 19 }
create text "Masculine row ending" as c23 at (5, 5) inside grid.cell(2, 3) { content: "-o", fontSize: 19 }
create text "Masculine row example" as c24 at (5, 5) inside grid.cell(2, 4) { content: "el libro", fontSize: 19 }

// Highlight endings as the rule to notice; these are common patterns, not
// absolute rules, so the explanatory copy deliberately says "suelen".
c03.tint("#FFD54F")
c11.tint("#FFB7C5")
c13.tint("#FFB7C5")
c22.tint("#81D4FA")
c23.tint("#81D4FA")

create text "English thanks" as thanksEn at (cw / 2 + 65, 495) inside board { content: "Thank you for your attention!", fontSize: 26, alignment: "center" }
create text "Spanish thanks" as thanksEs at (cw / 2 + 30, 528) inside board { content: "¡Gracias por su atención!", fontSize: 26, alignment: "center" }
thanksEn.tint("#F5E6C8")
thanksEs.tint("#F5E6C8")

// Each object starts hidden by its reveal mask and is erased by a wipe mask.
bind titleNode = node("Gender title")
bind explanationNode = node("Gender explanation")
bind feminineNode = node("Feminine label")
bind masculineNode = node("Masculine label")
bind tableBorder = table("Gender examples table")
bind englishThanks = node("English thanks")
bind spanishThanks = node("Spanish thanks")
bind feminineImage = node("female")
bind masculineImage = node("male")
bind chalkHand = node("paw with chalk")
bind ragHand = node("paw with rag")
bind laserHand = node("paw with laser")
bind emptyHand = node("paw empty")
bind writeSfx = audio("writing-on-black-board")
bind eraseSfx = audio("dry-erase")

// Stage 1 — title: written (1.5s full wobble + writing SFX), underlined by
// the laser after a 2.5s pause (mark takes no sound/wobble), erased after a
// 2.8s pause (1s rag wipe + erasing SFX). Pause, don't rush, between each.
reveal(titleNode, at: 0, over: 1.5, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: writeSfx)
mark(titleNode, at: 4, over: 1.2, visual: laserHand, visualScale: 4, visualAnchor: "top-center", visualDy: 200, visualDx: 50)
wipe(titleNode, at: 8, over: 1, visual: ragHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: eraseSfx)

// Stage 2 — the rule sentence, on its own: 1.5s write with full wobble, then
// a 3s pause so it can be read before the pictures arrive.
reveal(explanationNode, at: 12, over: 1.5, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: writeSfx)

// Stage 3 — both picture cards are presented first and share the board: each
// 1.5s carry (silent; carries take no sound) lands 3s apart so each arrival
// reads as its own beat.
carry(feminineImage, to: { x: 340, y: 365 }, approach: { x: 1500, y: 900 }, approachOver: 0.8, at: 16.5, over: 1.5, visual: emptyHand, visualScale: 4, visualAnchor: "top-center")
carry(masculineImage, to: { x: 750, y: 365 }, approach: { x: 1640, y: 900 }, approachOver: 0.8, at: 21, over: 1.5, visual: emptyHand, visualScale: 4, visualAnchor: "top-center")

// Stage 4 — with both cards on the board, a label is written below each one:
// 0.8s chalk writes with full wobble (short words earn the full weave),
// 2.7s apart.
reveal(feminineNode, at: 25.5, over: 0.8, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: writeSfx)
reveal(masculineNode, at: 29, over: 0.8, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: writeSfx)

// Stage 5 — labels wiped first, one after the other (0.8s rag wipes, 2.7s
// apart). Wiping before flying keeps the board readable to the last moment.
wipe(feminineNode, at: 32.5, over: 0.8, visual: ragHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: eraseSfx)
wipe(masculineNode, at: 36, over: 0.8, visual: ragHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: eraseSfx)

// Stage 6 — only then are the pictures flown away, one after the other
// (1.5s carries, 2.5s+ apart). The board is empty before the next stage.
carry(feminineImage, to: { x: 1500, y: 1200 }, approach: { x: 1500, y: 900 }, approachOver: 0.8, at: 39.5, over: 1.5, visual: emptyHand, visualScale: 4, visualAnchor: "top-center")
carry(masculineImage, to: { x: 1640, y: 1200 }, approach: { x: 1640, y: 900 }, approachOver: 0.8, at: 43.5, over: 1.5, visual: emptyHand, visualScale: 4, visualAnchor: "top-center")

// Stage 7 — rule sentence erased after a 3s pause (1s wipe + erasing SFX).
wipe(explanationNode, at: 48, over: 1, visual: ragHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: eraseSfx)

// Stage 8 — reveal only the empty border first (1.2s write; triple Y wobble
// so the weave reads across the ~830px width), then each cell written at its
// own pace: 0.1s per character with a 0.3s floor, chained 0.5s breath after
// each end. Dashes are quick (0.3s, no/little wobble), "Terminación" takes
// 1.1s with the full weave. Retiming a cell retimes its SFX clip too.
// Table reveal includes its cell subtree. Immediately erase those cell masks
// (without extra paw sprites) so the border can finish revealing empty, then
// the individual chalk reveals below fill cells in the authored order.
reveal(tableBorder, at: 52, over: 1.2, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 24, to: 54 }, wobbleSpeed: 7, sound: writeSfx)
wipe(c00, at: 52, over: 0.01, visual: none)
wipe(c01, at: 52, over: 0.01, visual: none)
wipe(c02, at: 52, over: 0.01, visual: none)
wipe(c03, at: 52, over: 0.01, visual: none)
wipe(c04, at: 52, over: 0.01, visual: none)
wipe(c10, at: 52, over: 0.01, visual: none)
wipe(c11, at: 52, over: 0.01, visual: none)
wipe(c12, at: 52, over: 0.01, visual: none)
wipe(c13, at: 52, over: 0.01, visual: none)
wipe(c14, at: 52, over: 0.01, visual: none)
wipe(c20, at: 52, over: 0.01, visual: none)
wipe(c21, at: 52, over: 0.01, visual: none)
wipe(c22, at: 52, over: 0.01, visual: none)
wipe(c23, at: 52, over: 0.01, visual: none)
wipe(c24, at: 52, over: 0.01, visual: none)
reveal(c00, at: 55.5, over: 0.6, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: writeSfx)
reveal(c01, at: 56.6, over: 0.8, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: writeSfx)
reveal(c02, at: 57.9, over: 0.9, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: writeSfx)
reveal(c03, at: 59.3, over: 1.1, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: writeSfx)
reveal(c04, at: 60.9, over: 0.7, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: writeSfx)
reveal(c10, at: 62.1, over: 0.8, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: writeSfx)
reveal(c11, at: 63.4, over: 0.3, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 4, to: 8 }, wobbleY: { from: 3, to: 6 }, wobbleSpeed: 7, sound: writeSfx)
reveal(c12, at: 64.2, over: 0.3, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", sound: writeSfx)
reveal(c13, at: 65, over: 0.3, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 4, to: 8 }, wobbleY: { from: 3, to: 6 }, wobbleSpeed: 7, sound: writeSfx)
reveal(c14, at: 65.8, over: 0.7, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: writeSfx)
reveal(c20, at: 67, over: 0.9, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: writeSfx)
reveal(c21, at: 68.4, over: 0.3, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", sound: writeSfx)
reveal(c22, at: 69.2, over: 0.3, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 4, to: 8 }, wobbleY: { from: 3, to: 6 }, wobbleSpeed: 7, sound: writeSfx)
reveal(c23, at: 70, over: 0.3, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 4, to: 8 }, wobbleY: { from: 3, to: 6 }, wobbleSpeed: 7, sound: writeSfx)
reveal(c24, at: 70.8, over: 0.8, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: writeSfx)

// Stage 9 — table wiped after a 2.9s pause (1.2s rag wipe), then thanks
// written one line at a time (1s writes, 2.5s+ apart) to close the lesson.
wipe(subtree(grid), at: 74.5, over: 1.2, visual: ragHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: eraseSfx)
reveal(englishThanks, at: 78.5, over: 1, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: writeSfx)
reveal(spanishThanks, at: 82, over: 1, visual: chalkHand, visualScale: 4, visualAnchor: "top-center", wobbleX: { from: 12, to: 24 }, wobbleY: { from: 8, to: 18 }, wobbleSpeed: 7, sound: writeSfx)
